{
  "expo": {
    "name": "MyShelf",
    "slug": "MyShelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE4F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.asorichetti.myshelf"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "MyShelf uses the camera to read book barcodes and covers. Nothing leaves your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyShelf opens your photos so you can choose a picture of a book's cover.",
          "cameraPermission": "MyShelf uses the camera so you can photograph a book's cover.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sharing"
    ],
    "scheme": "myshelf",
    "experiments": {
      "typedRoutes": true
    }
  }
}
