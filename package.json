{
  "name": "myshelf",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "selectors:gen": "node scripts/gen-selectors.mjs",
    "selectors:check": "node scripts/gen-selectors.mjs --check",
    "check": "npm run selectors:check && npm run typecheck && npm test -- --ci",
    "autotest:build": "cd tools/auto-test-suite && GOWORK=off go build -o bin/auto-test-suite .",
    "autotest:check": "cd tools/auto-test-suite && test -z \"$(gofmt -l .)\" || { gofmt -l . >&2; exit 1; } && GOWORK=off go vet ./... && GOWORK=off go test ./...",
    "autotest:install-browser": "cd tools/auto-test-suite && GOWORK=off go run github.com/mxschmitt/playwright-go/cmd/playwright install chromium",
    "autotest:smoke": "npm run -s autotest:build && tools/auto-test-suite/bin/auto-test-suite smoke",
    "autotest:journeys": "npm run -s autotest:build && tools/auto-test-suite/bin/auto-test-suite journey --all"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ]
  }
}
