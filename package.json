{
  "name": "myshelf",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^13.0.3",
    "commander": "15.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-expo": "~57.0.0",
    "playwright": "1.63.0",
    "react-test-renderer": "^19.2.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "jest",
    "selectors:gen": "node scripts/gen-selectors.mjs",
    "selectors:check": "node scripts/gen-selectors.mjs --check",
    "licences:gen": "node scripts/gen-licences.mjs",
    "licences:check": "node scripts/gen-licences.mjs --check",
    "e2eapi:gen": "tsx tools/auto-test-suite/src/mockapi/gen-native.ts",
    "e2eapi:check": "tsx tools/auto-test-suite/src/mockapi/gen-native.ts --check",
    "check": "npm run selectors:check && npm run licences:check && npm run e2eapi:check && npm run lint && npm run typecheck && npm test -- --ci",
    "autotest": "tsx tools/auto-test-suite/src/cli.ts",
    "autotest:check": "tsc -p tools/auto-test-suite && node --import tsx --test 'tools/auto-test-suite/src/**/*.test.ts'",
    "autotest:install-browser": "playwright install chromium",
    "autotest:selftest": "node --import tsx --test 'tools/auto-test-suite/src/**/*.selftest.ts'",
    "autotest:smoke": "tsx tools/auto-test-suite/src/cli.ts smoke",
    "autotest:journeys": "tsx tools/auto-test-suite/src/cli.ts journey --all",
    "lint": "eslint . --max-warnings 0",
    "test:live": "node --import tsx --test --test-concurrency=1 \"src/**/__live__/*.live.ts\"",
    "icons:render": "node scripts/render-icons.mjs",
    "media:hero": "node scripts/render-readme-hero.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/",
      "/__live__/"
    ],
    "setupFiles": [
      "<rootDir>/src/testing/jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/testing/jest.consoleGuard.ts"
    ],
    "testTimeout": 15000
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
