# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.keystore.base64
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# auto-test-suite evidence bundles: per-run, large, regenerated every invocation
/screenshots/
/tools/auto-test-suite/screenshots/

# test output
/coverage/


# Developer photos of real book covers used to record OCR fixtures: large, and
# the cover art is not ours to publish. Only the recognised text is committed.
/assets/test-images/

# Release signing: EAS local credentials point at the upload key. Never commit
# a keystore, its passwords or its base64 form (docs/release.md).
credentials.json
